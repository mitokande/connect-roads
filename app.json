{
  "expo": {
    "name": "Connect Roads",
    "slug": "connect-tracks",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#6EC3F5",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mithatcanturan.connectroads",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mithatcanturan.connectroads",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#8DD05F"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#6EC3F5"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4604843322018757~3769896564",
          "iosAppId": "ca-app-pub-4604843322018757~7537665465",
          "skAdNetworkItems": ["cstr6suwn9.skadnetwork"]
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This lets us show you ads that are more relevant to you. Connect Roads works the same either way."
        }
      ]
    ],
    "icon": "./assets/images/icon.png",
    "extra": {
      "eas": {
        "projectId": "64c34937-21c2-4e04-a177-f8a66abc9158"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-4604843322018757~3769896564",
    "ios_app_id": "ca-app-pub-4604843322018757~7537665465"
  }
}
