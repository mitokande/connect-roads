{
  "expo": {
    "name": "Connect Roads",
    "slug": "connect-tracks",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#6EC3F5",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mithatcanturan.connecttracks",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mithatcanturan.connecttracks",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#8DD05F"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "backgroundColor": "#6EC3F5"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-asset"
    ],
    "icon": "./assets/images/icon.png"
  }
}
